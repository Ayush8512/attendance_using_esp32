# =============================================================================
# Smart Attendance System — Environment Variables & Email SMTP Configuration
# =============================================================================

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your Gmail address (e.g. your_email@gmail.com)
SMTP_USER=your_email@gmail.com

# 16-character Gmail App Password (NOT your regular Gmail password)
# Generate from: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_digit_app_password

# Sender Email
SENDER_EMAIL=your_email@gmail.com
