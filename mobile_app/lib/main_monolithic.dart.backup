                            children: [
                              Icon(
                                isWindowOpen ? Icons.check_circle : (hasActiveSubject ? Icons.access_time_filled : Icons.info),
                                color: isWindowOpen ? Colors.green : (hasActiveSubject ? Colors.red : Colors.grey.shade700),
                                size: 18,
                              ),
                              const SizedBox(width: 8),
                              Expanded(
                                child: Text(
                                  isWindowOpen
